<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="900" prefWidth="1400" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pet_inventory.controller.HomePageController">


   <VBox prefHeight="900" prefWidth="1400" spacing="15" style="-fx-padding: 20;">
      <VBox prefHeight="64.0" prefWidth="1360.0">
         <children>
            <Label text="Select Date From:" />
            <DatePicker fx:id="datePickerFrom" />
            <Label text="Select Date To:" />
            <DatePicker fx:id="datePickerTo" />
         </children>
      </VBox>

            <!-- ================= EXPORT BUTTONS ================= -->
      <HBox alignment="CENTER_LEFT" spacing="10">
         <Button onAction="#exportReport" text="Export Report" />
      </HBox>

      <!-- ================= TABLE PREVIEW ================= -->
      <TableView fx:id="reportTable" prefHeight="700" prefWidth="1360">
         <columns>
            <TableColumn fx:id="orderID" minWidth="340.0" prefWidth="75.0" text="Order ID" />
            <TableColumn fx:id="totalAmount" minWidth="340.0" prefWidth="75.0" text="Total" />
            <TableColumn fx:id="paymentMethod" minWidth="340.0" prefWidth="75.0" text="Payment" />
            <TableColumn fx:id="dateCreated" minWidth="340.0" prefWidth="75.0" text="Date" />
         </columns></TableView>

   </VBox>
</StackPane>
