<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="900" prefWidth="1400" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pet_inventory.controller.AssistantController">

    <VBox alignment="TOP_CENTER" prefHeight="900" prefWidth="1400" spacing="20">

        <!-- Input Section -->
        <HBox alignment="CENTER" spacing="10">
            <TextArea fx:id="txtQuery" prefWidth="1000" promptText="E.g., 'Which product is running low?'" />
            <Button fx:id="btnSubmit" onAction="#submit" prefWidth="150" text="Submit" />
        </HBox>

        <!-- Result Table -->
        <Label style="-fx-font-size:18px; -fx-font-weight:bold;" text="Query Result:" />
        <TableView fx:id="tableResult" prefHeight="400" prefWidth="1200">
            <columns>
                <TableColumn fx:id="productUPC" prefWidth="150" text="ID" />
                <TableColumn fx:id="productName" prefWidth="400" text="Name" />
                <TableColumn fx:id="productCategory" prefWidth="250" text="Category" />
                <TableColumn fx:id="productQuantity" prefWidth="200" text="Quantity" />
                <TableColumn fx:id="productPrice" prefWidth="200" text="Price" />
            <TableColumn fx:id="numOfSold" prefWidth="200" text="Number of Sold" />
            </columns>
        </TableView>
      <ImageView fitHeight="62.0" fitWidth="78.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../icons/AI.png" />
         </image>
      </ImageView>

        <!-- Text Answer Section -->
        <Label style="-fx-font-size:18px; -fx-font-weight:bold;" text="Text Answer:" />
        <TextArea fx:id="txtAnswer" editable="false" prefHeight="439.0" prefWidth="1400.0" wrapText="true" />
    </VBox>

</StackPane>
