<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="900" prefWidth="1400" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pet_inventory.controller.SideBarController">

    <BorderPane>

        <!-- ================= LEFT SIDEBAR ================= -->
        <left>
            <AnchorPane fx:id="sidebar" prefWidth="240" styleClass="sidebar" stylesheets="@../theme/HomePage.css">

                <!-- Title -->
                <VBox alignment="CENTER" prefHeight="157.0" prefWidth="240.0" spacing="50.0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="20">

                    <Label styleClass="title" stylesheets="@../theme/HomePage.css" text="PET SHOP">
                        <font>
                            <Font size="20" />
                        </font>
                    </Label>
                    <Label fx:id="currentDate" alignment="CENTER" prefHeight="19.0" prefWidth="245.0" styleClass="welcome-text" stylesheets="@../theme/HomePage.css" text="Label" />
                </VBox>

                <!-- Menu -->
                <VBox alignment="CENTER" layoutY="89.0" prefHeight="762.0" prefWidth="240.0" spacing="30.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="89.0">

                    <Button onAction="#showDashboard" prefHeight="100.0" prefWidth="200.0" styleClass="sidebar-button" stylesheets="@../theme/HomePage.css" text="REPORT" />
                    <Button onAction="#showInventory" prefHeight="100.0" prefWidth="200.0" styleClass="sidebar-button" stylesheets="@../theme/HomePage.css" text="INVENTORY" />
                    <Button onAction="#showCheckout" prefHeight="100.0" prefWidth="200.0" styleClass="sidebar-button" stylesheets="@../theme/HomePage.css" text="CHECKOUT" />
                    <Button onAction="#showAssistant" prefHeight="100.0" prefWidth="200.0" styleClass="sidebar-button" stylesheets="@../theme/HomePage.css" text="AI ASSISTANT" />
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </VBox>

                <!-- Logout -->
                <HBox alignment="CENTER_LEFT" spacing="10" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20">

                    <ImageView fitHeight="35.0" fitWidth="37.0" styleClass="logout-icon">
                        <image>
                            <Image url="@../icons/logout.png" />
                        </image>
                    </ImageView>

                    <Label styleClass="logout-label" text="Sign out" />
                </HBox>

            </AnchorPane>
        </left>

        <!-- ================= CENTER CONTENT ================= -->
        <center>
            <AnchorPane fx:id="content">


            </AnchorPane>
        </center>

    </BorderPane>
</StackPane>
